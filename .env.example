# Copy this file to `.env` and fill in the values.
# `.env` is git-ignored — never commit real credentials.
#
# Only the variables below are read from the environment. Everything else
# (Resend, SMTP, SMS, Google Maps, IP geolocation, Analytics, reCAPTCHA) is
# configured from the admin dashboard at /admin/integrations and stored
# encrypted in the database — no env vars, no redeploy.

# ===== Database (required) =====
# Supabase Postgres or any standard Postgres.
# Supabase: Project Settings > Database > Connection string.
#   - Pooler (recommended for serverless/Vercel), port 6543:
#     postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#   - Direct connection, port 5432:
#     postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
# SSL is enabled automatically for every host except localhost/127.0.0.1.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ===== App (required) =====
# Public base URL of the site, no trailing slash. Used for canonical URLs,
# hreflang, sitemap, OG images and JSON-LD. Must be the real https:// domain in
# production — the build throws if it is missing there.
# Local: http://localhost:3000   Tunnel test: https://xxxx.ngrok-free.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs admin session tokens AND encrypts integration credentials at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs out every admin and makes saved integration keys unreadable.
APP_SECRET=change-me-to-a-64-char-hex-secret

# ===== Cloudflare R2 — image storage, S3-compatible (required) =====
# Cloudflare Dashboard > R2 > create a bucket, then "Manage R2 API Tokens" >
# Create API token with Object Read & Write on that bucket.
# R2_ACCOUNT_ID: Cloudflare dashboard sidebar (Account ID).
# R2_PUBLIC_URL: enable the bucket's public r2.dev subdomain, or attach a custom
#   domain. This host is also added to the Next.js image allowlist, so changing
#   it needs a rebuild. S3 endpoint used internally:
#   https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=doctor
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ===== Bootstrap admin (optional, used once by `npm run setup`) =====
# Creates the first super-admin account, then can be removed/commented out.
# `npm run setup` skips this step entirely when EMAIL or PASSWORD is empty.
# Use a strong password — this account owns the whole dashboard.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

# ===== Google Search Console (optional) =====
# The meta-tag verification token (the `content` value only, not the full tag).
# Set it on the live site to inline the verification tag on every page. Leave
# unset locally; once the domain is verified by DNS you no longer need it.
# GOOGLE_SITE_VERIFICATION=your_gsc_meta_token
